# ─────────────────────────────────────────────────────────────────
# Makeup by Shareen — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────
# The canonical public URL of the site (no trailing slash).
# Set this as a GitHub Actions variable (vars.NEXT_PUBLIC_SITE_URL),
# not a secret, since it's embedded in the client bundle.
NEXT_PUBLIC_SITE_URL=https://your-site.azurestaticapps.net

# ── Contact Form ─────────────────────────────────────────────────
# Option A — Formspree (https://formspree.io)
# Create a form, grab the 8-char ID from the endpoint URL, and add
# it here. Store as a GitHub Actions secret so it isn't in the bundle.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Option B — EmailJS (https://www.emailjs.com)
# Uncomment and fill in if you prefer EmailJS instead of Formspree.
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ── Azure Deployment (CI/CD only — do NOT put here) ──────────────
# AZURE_STATIC_WEB_APPS_API_TOKEN is set as a GitHub Actions secret
# in your repo settings → Secrets and variables → Actions.
# Azure generates this token when you create the Static Web App resource.
# It is never needed locally and should never appear in any .env file.
